# Host port used by Docker Compose.
PORT=3000

# New-table attempts per client IP (IPv6 addresses share a /64 quota).
# Existing joins, reconnects and play do not consume this quota.
ROOM_CREATE_LIMIT=60
ROOM_CREATE_WINDOW_MS=3600000

# Leave empty for direct/LAN hosting. For a reverse proxy, list ONLY its exact
# source IP addresses or CIDRs as seen by the app, separated by commas.
# The proxy must sanitize X-Forwarded-For. Never trust arbitrary clients.
TRUSTED_PROXIES=

# For direct Node runs, room saves default to ./data.
# Docker Compose stores them in the tarok-data volume at /app/data.
# DATA_DIR=./data
